face "dhawan-home" {
  meta {
    owl: 23
    description: "Vantablack OLED Main Home Dashboard"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  page: -1
  statusBar: false

  // --- Real-time Device & Environment Sources ---
  source now = clock every 1m
  source sys = android.system every 5s
  source bat = android.battery
  source alarm = android.alarm
  source modes = android.modes
  source vol = android.volume
  source wx = http("https://wttr.in/Bengaluru?format=j1") every 30m timeout 10s json
  source notifs = android.notifications
  source net = android.network every 2s

  // --- Vantablack High-Contrast Monochrome Design Tokens ---
  let c_bg = "#000000"
  let c_card = "#121214"
  let c_border = "#262629"
  let c_pill_off = "#1C1C1E"
  let c_pill_on = "#FFFFFF"
  let c_text_pri = "#FFFFFF"
  let c_text_sec = "#8E8E93"

  // --- Dynamic Greeting & Time Computations ---
  let hr = num(fmtTime(now, "H"))
  let greet = hr < 12 ? "Good morning" : hr < 17 ? "Good afternoon" : hr < 21 ? "Good evening" : "Good night"
  let upSec = sys.uptime ?? 3600
  let upHours = floor(upSec / 3600)
  let upMins = floor((upSec % 3600) / 60)
  let uptimeStr = "${upHours}h ${upMins}m"

  // Weather extraction
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let place = wx.nearest_area[0].areaName[0].value ?? "Bengaluru"
  let tempC = cur ? cur.temp_C : "26"
  let condText = cur ? cur.weatherDesc[0].value : "Sunny"
  let tempMax = day ? day.maxtempC : "30"
  let tempMin = day ? day.mintempC : "20"

  // Calendar week calculations (7 days: Monday to Sunday)
  let dayName = fmtTime(now, "E", null, "en")
  let dayOfWeek = dayName == "Mon" ? 0 : dayName == "Tue" ? 1 : dayName == "Wed" ? 2 : dayName == "Thu" ? 3 : dayName == "Fri" ? 4 : dayName == "Sat" ? 5 : 6
  let weekLabels = ["M", "T", "W", "T", "F", "S", "S"]

  // Telemetry ratios
  let batLevel = bat.level ?? 85
  let memTotal = sys.memory.total ?? 1
  let memUsed = sys.memory.used ?? 0
  let memRatio = memTotal > 0 ? (memUsed / memTotal) : 0.45
  let memPct = round(memRatio * 100)

  let storTotal = sys.storage.total ?? 1
  let storFree = sys.storage.free ?? 0
  let storUsed = storTotal - storFree
  let storRatio = storTotal > 0 ? (storUsed / storTotal) : 0.60
  let storPct = round(storRatio * 100)

  // Network speed computations
  state netDown = 0
  state netUp = 0
  on net {
    if old != null && value.rx >= old.rx && value.uptime > old.uptime {
      let dt = value.uptime - old.uptime
      if dt > 0 {
        netDown = (value.rx - old.rx) / dt
        netUp = (value.tx - old.tx) / dt
      }
    }
  }

  // Slide-to-dismiss notification states
  state dragging = ""
  state dragX = 0
  state swiped = ""

  background: c_bg
  padding: [16, 20, 16, 20]

  Column {
    gap: 14
    fill: width
    scroll: true

    // ==========================================
    // 1. TOP GREETING HEADER
    // ==========================================
    Row {
      fill: width
      align: center
      gap: 12

      // Circular "D" avatar badge
      Box {
        size: 42
        radius: 21
        background: c_card
        border: 1
        borderColor: c_border
        align: center
        Text {
          text: "D"
          fontSize: 18
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // Greeting and dynamic uptime subtitle
      Column {
        weight: 1
        gap: 2
        Text {
          text: greet
          fontSize: 16
          bold: true
          color: c_text_pri
        }
        Text {
          text: "Dhawan • up ${uptimeStr}"
          fontSize: 12
          color: c_text_sec
        }
      }

      // Top Action Buttons: Music Player, Work, All Apps & Settings
      Row {
        gap: 6
        align: center

        // Music Player Trigger (Page -1)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:-2")
          }
          Text {
            text: "🎵"
            fontSize: 14
            align: center
          }
        }

        // Work & Uni Workspace Trigger (Page 0)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:0")
          }
          Text {
            text: "💼"
            fontSize: 14
            align: center
          }
        }

        // All Apps Drawer Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("drawer")
          }
          Text {
            text: "⊞"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }

        // Settings & Customization Gear Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("settings")
          }
          Text {
            text: "⚙"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }
      }
    }

    // ==========================================
    // 2. CLOCK, WEATHER & WEEK STRIP CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 18
      gap: 14

      // Top Row: Big Digital Clock & Live Weather Readout
      Row {
        fill: width
        align: center

        // Clock Block -> Tapping opens Clock/Alarm app
        Column {
          weight: 1
          gap: 2
          onTap: {
            haptic("light")
            androidApp("clock")
          }
          Text {
            spans: [
              fmtTime(now, "HH"),
              { text: ":", color: c_text_sec },
              fmtTime(now, "mm")
            ]
            fontSize: 48
            bold: true
            letterSpacing: -2
            color: c_text_pri
          }
          Text {
            text: fmtTime(now, "EEEE, d MMMM")
            fontSize: 13
            color: c_text_sec
          }
        }

        // Weather Block -> Tapping opens Weather
        Column {
          align: end
          gap: 2
          onTap: {
            haptic("light")
            androidApp("weather")
          }
          Text {
            text: "${tempC}°"
            fontSize: 34
            bold: true
            color: c_text_pri
          }
          Text {
            text: condText
            fontSize: 12
            bold: true
            color: c_text_sec
          }
          Text {
            text: "↑${tempMax}° ↓${tempMin}°"
            fontSize: 11
            color: c_text_sec
          }
        }
      }

      // 7-Day Horizontal Calendar Strip (Highlights today in solid white pill)
      Row {
        fill: width
        align: center
        gap: 6
        onTap: calendar("open")
        for i in range(7) {
          let isToday = i == dayOfWeek
          let dayDate = fmtTime(now + (i - dayOfWeek) * 86400, "d")
          Column {
            weight: 1
            align: center
            justify: center
            gap: 4
            padding: [0, 8]
            radius: 12
            background: isToday ? c_pill_on : c_pill_off
            border: isToday ? 0 : 1
            borderColor: c_border
            Text {
              text: weekLabels[i]
              fontSize: 11
              bold: true
              align: center
              color: isToday ? "#000000" : c_text_sec
            }
            Text {
              text: dayDate
              fontSize: 13
              bold: isToday
              align: center
              color: isToday ? "#000000" : c_text_pri
            }
          }
        }
      }

      // Bottom Status Pills: Location/Condition & Genuine Next Alarm
      Row {
        fill: width
        gap: 8

        // Location & Condition Pill
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: {
            haptic("light")
            androidApp("weather")
          }
          Text { text: "📍"; fontSize: 11; align: center }
          Text {
            text: "${condText} • ${place}"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: c_text_pri
          }
        }

        // Alarm Pill (Reads genuine Android system next-alarm broadcast/API)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: {
            haptic("light")
            androidApp("clock")
          }
          Text { text: "⏰"; fontSize: 11; align: center }
          Text {
            text: alarm.set ? fmtTime(alarm.time, "EEE HH:mm") : "No alarm set"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: alarm.set ? c_text_pri : c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 3. SAMSUNG-STYLE QUICK CONTROLS ICONS
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 14

      Row {
        fill: width
        align: center
        Text {
          text: "QUICK CONTROLS"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: "ONE UI STYLE"
          style: label
          fontSize: 10
          color: c_text_sec
        }
      }

      // Samsung Notification Panel Circular Icon Toggles
      Row {
        fill: width
        align: center
        justify: spaceEvenly

        // 1. Torch
        let torchOn = modes.torch == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); torch("toggle") }
          Box {
            size: 48
            radius: 24
            background: torchOn ? c_pill_on : c_pill_off
            border: torchOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "🔦"
              fontSize: 20
              align: center
            }
          }
          Text {
            text: "Torch"
            fontSize: 10
            bold: true
            color: torchOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 2. Sound / Mute
        let isMuted = vol.muted || (vol.level ?? 0) == 0
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); volume("toggle") }
          Box {
            size: 48
            radius: 24
            background: !isMuted ? c_pill_on : c_pill_off
            border: !isMuted ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: isMuted ? "🔇" : "🔊"
              fontSize: 20
              align: center
            }
          }
          Text {
            text: isMuted ? "Mute" : "Sound"
            fontSize: 10
            bold: true
            color: !isMuted ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 3. DND
        let dndOn = modes.dnd == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); dnd("toggle") }
          Box {
            size: 48
            radius: 24
            background: dndOn ? c_pill_on : c_pill_off
            border: dndOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "🌙"
              fontSize: 20
              align: center
              color: dndOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "DND"
            fontSize: 10
            bold: true
            color: dndOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 4. Wi-Fi
        let wifiOn = modes.wifi == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); settings("wifi") }
          Box {
            size: 48
            radius: 24
            background: wifiOn ? c_pill_on : c_pill_off
            border: wifiOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "📶"
              fontSize: 20
              align: center
            }
          }
          Text {
            text: "Wi-Fi"
            fontSize: 10
            bold: true
            color: wifiOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 5. Bluetooth
        let btOn = modes.bluetooth == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); settings("bluetooth") }
          Box {
            size: 48
            radius: 24
            background: btOn ? c_pill_on : c_pill_off
            border: btOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "ᛒ"
              fontSize: 20
              bold: true
              align: center
              color: btOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "Bluetooth"
            fontSize: 10
            bold: true
            color: btOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 6. Terminal / btop
        Column {
          align: center
          gap: 6
          onTap: { haptic("medium"); terminal() }
          Box {
            size: 48
            radius: 24
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text {
              text: "💻"
              fontSize: 20
              align: center
            }
          }
          Text {
            text: "Terminal"
            fontSize: 10
            bold: true
            color: c_text_sec
            align: center
          }
        }
      }

      // Media Volume Slider Bar
      Column {
        fill: width
        gap: 4
        Row {
          fill: width
          align: center
          Text { text: "VOLUME LEVEL"; fontSize: 10; color: c_text_sec; weight: 1 }
          Text { text: "${vol.level ?? 0}%"; fontSize: 11; bold: true; color: c_text_pri }
        }
        Slider {
          value: vol.level ?? 0
          min: 0
          max: 100
          live: true
          fill: width
          color: c_text_pri
          track: "#2C2C2E"
          onChange: volume(value)
        }
      }
    }

    // ==========================================
    // 4. FAVORITE APPS (WhatsApp, Instagram, Phone, Messages, Brave, Camera)
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text {
          text: "⚡  FAVORITE APPS"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: "QUICK LAUNCH"
          style: label
          fontSize: 10
          color: c_text_sec
        }
      }

      Row {
        fill: width
        align: center
        justify: spaceEvenly

        // WhatsApp
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("com.whatsapp") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "💬"; fontSize: 22; align: center }
          }
          Text { text: "WhatsApp"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }

        // Instagram
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("com.instagram.android") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "📸"; fontSize: 22; align: center }
          }
          Text { text: "Instagram"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }

        // Phone
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("phone") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "📞"; fontSize: 22; align: center }
          }
          Text { text: "Phone"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }

        // Messages
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("messages") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "✉"; fontSize: 22; align: center }
          }
          Text { text: "Messages"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }

        // Brave Browser
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("com.brave.browser") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "🦁"; fontSize: 22; align: center }
          }
          Text { text: "Brave"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }

        // Camera
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); androidApp("camera") }
          Box {
            size: 46
            radius: 14
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text { text: "📷"; fontSize: 22; align: center }
          }
          Text { text: "Camera"; fontSize: 10; bold: true; maxLines: 1; color: c_text_pri }
        }
      }
    }

    // ==========================================
    // 5. COMPACT DEVICE & NETWORK TELEMETRY
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text {
          text: "DEVICE & NETWORK TELEMETRY"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: "REAL-TIME"
          style: label
          fontSize: 10
          color: c_text_sec
        }
      }

      // Compact Telemetry Metrics Row
      Row {
        fill: width
        gap: 8

        // Battery Chip
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: bat.charging ? "⚡" : "🔋"; fontSize: 16; align: center }
          Column {
            gap: 1
            Text { text: "${batLevel}%"; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: bat.charging ? "Charging" : "Battery"; fontSize: 9; color: c_text_sec }
          }
        }

        // Network Speed (Download)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "📶"; fontSize: 16; align: center }
          Column {
            gap: 1
            Text { text: "${fmtBytes(netDown)}/s"; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: "Down speed"; fontSize: 9; color: c_text_sec }
          }
        }

        // RAM Memory Chip
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "🧠"; fontSize: 16; align: center }
          Column {
            gap: 1
            Text { text: "${memPct}%"; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: "RAM used"; fontSize: 9; color: c_text_sec }
          }
        }
      }

      // Secondary Telemetry Metrics Row
      Row {
        fill: width
        gap: 8

        // Storage Free
        Row {
          weight: 1
          padding: [8, 8]
          radius: 10
          background: c_bg
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "💾"; fontSize: 12; align: center }
          Text { text: "Storage: ${fmtBytes(storFree)} free"; fontSize: 10; color: c_text_sec; weight: 1 }
        }

        // Network Upload
        Row {
          weight: 1
          padding: [8, 8]
          radius: 10
          background: c_bg
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "⬆"; fontSize: 12; align: center }
          Text { text: "Upload: ${fmtBytes(netUp)}/s"; fontSize: 10; color: c_text_sec; weight: 1 }
        }
      }
    }

    // ==========================================
    // 5. COMPACT NOTIFICATIONS FEED CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      // Header: Bell Icon, Title, Unread Count Pill
      Row {
        fill: width
        align: center
        Text {
          text: "🔔  NOTIFICATIONS"
          style: label
          fontSize: 11
          color: c_text_pri
          weight: 1
        }
        Row {
          padding: [8, 4]
          radius: 10
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          Text {
            text: "${len(notifs.items ?? [])} unread"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }
      }

      // Stacked Notification Rows
      let notifList = (notifs.items ?? []).take(3)
      if len(notifList) == 0 {
        Text {
          text: "All caught up • No notifications"
          fontSize: 12
          color: c_text_sec
          padding: [0, 4]
        }
      } else {
        Column {
          fill: width
          gap: 10
          for nItem in notifList key nItem.key {
            Row {
              fill: width
              align: center
              gap: 10
              padding: [6, 4]
              offset: [dragging == nItem.key ? dragX : 0, 0]
              animate offset: spring(0.8, 400)
              opacity: dragging == nItem.key ? max(0.2, 1 - abs(dragX) / 250) : 1
              drag: horizontal
              onDrag: {
                if nItem.clearable {
                  dragging = nItem.key
                  dragX = dragX + dx
                }
              }
              onDragEnd: {
                if dragging == nItem.key && (abs(dragX) > 80 || abs(vx) > 800) {
                  swiped = nItem.key
                  notification("dismiss", nItem.key)
                }
                dragging = ""
                dragX = 0
              }
              onTap: notification("open", nItem.key)

              // App Icon / Glyph
              Image {
                src: nItem.icon
                size: 32
                radius: 8
              }

              // Text preview
              Column {
                weight: 1
                gap: 2
                Text {
                  text: nItem.title ?? "Alert"
                  fontSize: 13
                  bold: true
                  maxLines: 1
                  color: c_text_pri
                }
                Text {
                  text: nItem.text ?? ""
                  fontSize: 11
                  maxLines: 1
                  color: c_text_sec
                }
              }

              // Relative timestamp
              Text {
                text: fmtAgo(nItem.time, now)
                fontSize: 10
                color: c_text_sec
              }
            }
          }
        }
      }
    }

    // ==========================================
    // 6. QUICK LAUNCH DOCK (PLAYER, APPS & WORK)
    // ==========================================
    Row {
      fill: width
      gap: 8

      // Music Player Button (Page -1)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:-2")
        }
        Text {
          text: "🎵"
          fontSize: 14
          align: center
        }
        Text {
          text: "PLAYER"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // All Apps Drawer Launcher Button
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_pill_on
        onTap: {
          haptic("medium")
          launcher("drawer")
        }
        Text {
          text: "⊞"
          fontSize: 15
          bold: true
          align: center
          color: "#000000"
        }
        Text {
          text: "ALL APPS"
          fontSize: 11
          bold: true
          align: center
          color: "#000000"
        }
      }

      // Work & Uni Workspace Button (Page 0)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:0")
        }
        Text {
          text: "💼"
          fontSize: 14
          align: center
        }
        Text {
          text: "WORK"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }
    }

    // Bottom Navigation Bar Spacing
    Spacer { height: screenInset + 12 }
  }
}
