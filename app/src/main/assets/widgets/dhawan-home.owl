face "dhawan-home" {
  meta {
    owl: 26
    description: "Vantablack OLED Main Home Dashboard"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  page: -1
  statusBar: false

  // --- Real-time Device & Environment Sources ---
  source now = clock every 1m
  source sys = android.system every 5s
  source bat = android.battery
  source alarm = android.alarm
  source modes = android.modes
  source vol = android.volume

  // --- Dynamic Weather Location (empty string "" defaults to wttr.in Auto IP/GPS location) ---
  state city = "Bengaluru" persist
  state editCity = false
  state cityInput = ""
  source wx = http("https://wttr.in/${enc(city)}?format=j1") every 30m timeout 10s json
  source notifs = android.notifications
  source net = android.network every 2s
  // Every app on the phone (Android, Linux and owl apps), for the editable favourites and the app picker.
  source d = android.drawer

  // --- Vantablack High-Contrast Monochrome Design Tokens ---
  let c_bg = "#000000"
  let c_card = "#121214"
  let c_border = "#262629"
  let c_pill_off = "#1C1C1E"
  let c_pill_on = "#FFFFFF"
  let c_text_pri = "#FFFFFF"
  let c_text_sec = "#8E8E93"

  // --- Liquid glass: a pane lit from the top left, a bright rim, and a springy press ---
  let c_glass = linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.11), alpha("#FFFFFF", 0.035)])
  let c_glass_edit = linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.18), alpha("#FFFFFF", 0.06)])
  let c_rim = alpha("#FFFFFF", 0.16)
  let c_rim_edit = alpha("#FFFFFF", 0.45)
  let c_clear = alpha("#000000", 0)

  // --- Dynamic Greeting & Time Computations ---
  let hr = num(fmtTime(now, "H"))
  let greet = hr < 12 ? "Good morning" : hr < 17 ? "Good afternoon" : hr < 21 ? "Good evening" : "Good night"
  // Unknown data shows as a dash rather than a made-up reading.
  let upSec = sys.uptime ?? 0
  let upHours = floor(upSec / 3600)
  let upMins = floor((upSec % 3600) / 60)
  let uptimeStr = sys.uptime != null ? "${upHours}h ${upMins}m" : "—"

  // Weather extraction
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let detectedArea = wx.nearest_area[0].areaName[0].value
  let place = city != "" ? (detectedArea ?? city) : (detectedArea ?? "Current Location")
  let tempC = cur ? cur.temp_C : "—"
  let condText = cur ? cur.weatherDesc[0].value : "No weather"
  let tempMax = day ? day.maxtempC : "—"
  let tempMin = day ? day.mintempC : "—"

  // Calendar week calculations (7 days: Monday to Sunday)
  let dayName = fmtTime(now, "E", null, "en")
  let dayOfWeek = dayName == "Mon" ? 0 : dayName == "Tue" ? 1 : dayName == "Wed" ? 2 : dayName == "Thu" ? 3 : dayName == "Fri" ? 4 : dayName == "Sat" ? 5 : 6
  let weekLabels = ["M", "T", "W", "T", "F", "S", "S"]

  // Telemetry ratios
  let batText = bat.level != null ? "${bat.level}%" : "—"
  let memTotal = sys.memory.total ?? 1
  let memUsed = sys.memory.used ?? 0
  let memRatio = memTotal > 0 ? (memUsed / memTotal) : 0
  let memText = sys.memory.total != null ? "${round(memRatio * 100)}%" : "—"

  let storTotal = sys.storage.total ?? 1
  let storFree = sys.storage.free ?? 0
  let storUsed = storTotal - storFree
  let storRatio = storTotal > 0 ? (storUsed / storTotal) : 0
  let storPct = round(storRatio * 100)

  // Network speed computations
  state netDown = 0
  state netUp = 0
  on net {
    if old != null && value.rx >= old.rx && value.uptime > old.uptime {
      let dt = value.uptime - old.uptime
      if dt > 0 {
        netDown = (value.rx - old.rx) / dt
        netUp = (value.tx - old.tx) / dt
      }
    }
  }

  // Slide-to-dismiss notification states
  state dragging = ""
  state dragX = 0
  state swiped = ""

  // Quick Controls expanded state
  state showMoreControls = false persist

  // --- Editable app tiles & backup states ---
  // Each section's tiles, by section id: drawer keys once edited. Until then a section shows its defaults, given by
  // package name, which match that app's drawer key ("a:<package>/<activity>"), or by the app's name ("Phone").
  state tiles = {} persist
  // The section in edit mode, "" for none.
  state editing = ""
  // The app picker: the section and the tile it replaces, -1 to add one; "" while it's closed.
  state pickSec = ""
  state pickIdx = -1
  state query = ""
  // The node under the finger, for the press spring.
  state pressed = ""
  // Backup / Import state
  state importSec = false
  state importText = ""

  let allApps = d.apps ?? []
  let picks = query == "" ? take(allApps, 60) : take(rank(allApps, query), 40)

  // One app tile: the app's own icon as a white silhouette on glass. In edit mode a tap picks another app for it.
  // compact: a glass squircle with the name under it, for a row of many; else a card with both inside.
  component AppTile(sec, ref, i, list, compact) {
    let a = find(allApps, x => x.key == ref || startsWith(x.key, "a:" + ref + "/") || lower(x.name) == lower(ref))
    let id = sec + ":" + i
    let isEditing = editing == sec
    Column {
      padding: compact ? [0, 2] : [10, 14]
      radius: 16
      background: compact ? c_clear : (isEditing ? c_glass_edit : c_glass)
      border: compact ? 0 : 1
      borderColor: isEditing ? c_rim_edit : c_rim
      align: center
      justify: center
      gap: 6
      scale: pressed == id ? 0.92 : 1
      animate scale: spring(0.55, 600)
      opacity: a == null ? 0.45 : 1
      onPress: pressed = id
      onRelease: pressed = ""
      onTap: {
        haptic("light")
        if isEditing {
          pickSec = sec
          pickIdx = i
          query = ""
        } else if a != null {
          open(a.key)
        }
      }
      onLongPress: {
        haptic("medium")
        editing = isEditing ? "" : sec
      }
      Box {
        size: compact ? 50 : 28
        radius: 16
        background: compact ? (isEditing ? c_glass_edit : c_glass) : c_clear
        border: compact ? 1 : 0
        borderColor: isEditing ? c_rim_edit : c_rim
        align: center
        if a != null && a.hasIcon {
          Image { src: a.mask; size: 26; tint: c_text_pri; label: a.label }
        } else {
          Text { text: a != null ? a.initials : "?"; fontSize: 14; bold: true; color: c_text_pri; align: center }
        }
        if isEditing {
          // Remove badge, at the icon's corner.
          Box {
            size: 20
            radius: 10
            offset: compact ? [20, -20] : [16, -14]
            background: c_pill_on
            align: center
            onTap: {
              haptic("light")
              tiles = set(tiles, sec, remove(list, i))
            }
            Text { text: "×"; fontSize: 13; bold: true; color: "#000000"; align: center }
          }
        }
      }
      Text {
        text: a != null ? a.name : "not installed"
        fontSize: compact ? 10 : 11
        bold: true
        align: center
        maxLines: 1
        color: c_text_pri
      }
    }
  }

  // A card of app tiles that you can change: long-press a tile or tap "edit", then tap a tile to swap its app,
  // its × to remove it, or + to add one.
  component AppSection(sec, title, defaults, cols, compact = false) {
    let list = get(tiles, sec, defaults)
    let isEditing = editing == sec
    let shown = isEditing ? list : filter(list, r => find(allApps, x => x.key == r || startsWith(x.key, "a:" + r + "/") || lower(x.name) == lower(r)) != null)
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text { text: title; style: label; fontSize: 11; color: c_text_sec; weight: 1 }
        Row {
          padding: [10, 5]
          radius: 10
          background: isEditing ? c_pill_on : c_glass
          border: isEditing ? 0 : 1
          borderColor: c_rim
          onTap: {
            haptic("light")
            editing = isEditing ? "" : sec
          }
          Text { text: isEditing ? "DONE" : "EDIT"; style: label; fontSize: 10; bold: true; color: isEditing ? "#000000" : c_text_sec }
        }
      }

      Grid {
        columns: cols
        gap: 8
        fill: width
        for r, i in shown {
          AppTile { sec: sec; ref: r; i: isEditing ? i : indexOf(list, r); list: list; compact: compact }
        }
        if isEditing {
          // Add a tile.
          Column {
            padding: compact ? [0, 2] : [10, 14]
            radius: 16
            border: compact ? 0 : 1
            borderColor: c_rim_edit
            align: center
            justify: center
            gap: 6
            onTap: {
              haptic("light")
              pickSec = sec
              pickIdx = -1
              query = ""
            }
            Box { size: compact ? 50 : 28; radius: 16; border: compact ? 1 : 0; borderColor: c_rim_edit; align: center; Text { text: "+"; fontSize: 22; color: c_text_pri; align: center } }
            Text { text: "add"; fontSize: 11; bold: true; align: center; color: c_text_sec }
          }
        }
      }

      if isEditing {
        Row {
          fill: width
          justify: spaceBetween
          align: center
          Text { text: "tap tile to change • × to remove"; fontSize: 10; color: c_text_sec }
          Row {
            gap: 8
            align: center
            Text {
              text: "Backup"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("light")
                copy(toJson(tiles))
                notify("My Launcher", "Tiles backup copied to clipboard")
              }
            }
            Text {
              text: "Import"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("light")
                importSec = true
                importText = ""
              }
            }
            Text {
              text: "Reset"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("medium")
                tiles = remove(tiles, sec)
              }
            }
            Text {
              text: "Reset All"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("strong")
                tiles = {}
              }
            }
          }
        }
      }

      // The app picker, over everything, for this section.
      Popup {
        visible: pickSec == sec
        onDismiss: {
          pickSec = ""
          query = ""
        }
        width: screenWidth - 48
        padding: 12
        background: "#161618"
        radius: 20
        border: 1
        borderColor: c_rim
        Column {
          fill: width
          gap: 8
          Row {
            fill: width
            align: center
            padding: [10, 8]
            radius: 12
            background: c_pill_off
            Input {
              weight: 1
              placeholder: "Search apps"
              underline: false
              color: c_text_pri
              fontSize: 14
              onChange: query = value
            }
          }
          Column {
            fill: width
            height: 340
            scroll: true
            gap: 2
            for a in picks {
              Row {
                fill: width
                align: center
                gap: 12
                padding: [8, 10]
                radius: 12
                onTap: {
                  haptic("light")
                  let next = pickIdx < 0 ? list + [a.key] : set(list, pickIdx, a.key)
                  tiles = set(tiles, sec, next)
                  pickSec = ""
                  query = ""
                }
                Box {
                  size: 28
                  align: center
                  if a.hasIcon {
                    Image { src: a.mask; size: 24; tint: c_text_pri; label: a.label }
                  } else {
                    Text { text: a.initials; fontSize: 12; bold: true; color: c_text_pri }
                  }
                }
                Text { text: a.name; fontSize: 14; color: c_text_pri; weight: 1; maxLines: 1 }
              }
            }
          }
        }
      }

      // The import backup popup, over everything.
      Popup {
        visible: importSec
        onDismiss: {
          importSec = false
          importText = ""
        }
        width: screenWidth - 48
        padding: 16
        background: "#161618"
        radius: 20
        border: 1
        borderColor: c_rim
        Column {
          fill: width
          gap: 12
          Row {
            fill: width
            justify: spaceBetween
            align: center
            Text { text: "RESTORE TILES BACKUP"; style: label; fontSize: 11; color: c_text_sec }
            Text {
              text: "✕"
              fontSize: 14
              color: c_text_sec
              onTap: {
                importSec = false
                importText = ""
              }
            }
          }
          Text {
            text: "Paste your exported tiles JSON configuration below:"
            fontSize: 12
            color: c_text_sec
          }
          Row {
            fill: width
            align: center
            padding: [10, 8]
            radius: 12
            background: c_pill_off
            border: 1
            borderColor: c_border
            Input {
              weight: 1
              placeholder: "Paste JSON here..."
              underline: false
              color: c_text_pri
              fontSize: 13
              onChange: importText = value
              onSubmit: {
                haptic("medium")
                let p = parseJson(value)
                if p != null {
                  tiles = p
                  importSec = false
                  importText = ""
                  notify("My Launcher", "Tiles configuration restored")
                }
              }
            }
          }
          Row {
            fill: width
            justify: flexEnd
            gap: 8
            Box {
              padding: [8, 14]
              radius: 10
              background: c_pill_off
              onTap: {
                importSec = false
                importText = ""
              }
              Text { text: "Cancel"; fontSize: 12; color: c_text_sec }
            }
            Box {
              padding: [8, 14]
              radius: 10
              background: c_pill_on
              onTap: {
                haptic("medium")
                let p = parseJson(importText)
                if p != null {
                  tiles = p
                  importSec = false
                  importText = ""
                  notify("My Launcher", "Tiles configuration restored")
                }
              }
              Text { text: "Apply"; fontSize: 12; bold: true; color: "#000000" }
            }
          }
        }
      }
    }
  }

  background: c_bg
  padding: [16, 20, 16, 20]

  Column {
    gap: 14
    fill: width
    scroll: true

    // ==========================================
    // 1. TOP GREETING HEADER
    // ==========================================
    Row {
      fill: width
      align: center
      gap: 12

      // Circular "D" avatar badge
      Box {
        size: 42
        radius: 21
        background: c_card
        border: 1
        borderColor: c_border
        align: center
        Text {
          text: "D"
          fontSize: 18
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // Greeting and dynamic uptime subtitle
      Column {
        weight: 1
        gap: 2
        Text {
          text: greet
          fontSize: 16
          bold: true
          color: c_text_pri
        }
        Text {
          text: "Dhawan • up ${uptimeStr}"
          fontSize: 12
          color: c_text_sec
        }
      }

      // Top Action Buttons: Music Player, Work, All Apps & Settings
      Row {
        gap: 6
        align: center

        // Music Player Trigger (Page -1)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:-2")
          }
          Text {
            text: "♪"
            fontSize: 14
            align: center
          }
        }

        // Work & Uni Workspace Trigger (Page 0)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:0")
          }
          Text {
            text: "▤"
            fontSize: 14
            align: center
          }
        }

        // All Apps Drawer Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("drawer")
          }
          Text {
            text: "⊞"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }

        // Settings & Customization Gear Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("settings")
          }
          Text {
            text: "⚙︎"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }
      }
    }

    // ==========================================
    // 2. CLOCK, WEATHER & WEEK STRIP CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 18
      gap: 14

      // Top Row: Big Digital Clock & Live Weather Readout
      Row {
        fill: width
        align: center

        // Clock Block -> Tapping opens Clock/Alarm app
        Column {
          weight: 1
          gap: 2
          onTap: {
            haptic("light")
            androidApp("clock")
          }
          Text {
            spans: [
              fmtTime(now, "HH"),
              { text: ":", color: c_text_sec },
              fmtTime(now, "mm")
            ]
            fontSize: 48
            bold: true
            letterSpacing: -2
            color: c_text_pri
          }
          Text {
            text: fmtTime(now, "EEEE, d MMMM")
            fontSize: 13
            color: c_text_sec
          }
        }

        // Weather Block -> Tapping opens Weather
        Column {
          align: end
          gap: 2
          onTap: {
            haptic("light")
            androidApp("weather")
          }
          Text {
            text: "${tempC}°"
            fontSize: 34
            bold: true
            color: c_text_pri
          }
          Text {
            text: condText
            fontSize: 12
            bold: true
            color: c_text_sec
          }
          Text {
            text: "↑${tempMax}° ↓${tempMin}°"
            fontSize: 11
            color: c_text_sec
          }
        }
      }

      // 7-Day Horizontal Calendar Strip (Highlights today in solid white pill)
      Row {
        fill: width
        align: center
        gap: 6
        onTap: calendar("open")
        for i in range(7) {
          let isToday = i == dayOfWeek
          let dayDate = fmtTime(now + (i - dayOfWeek) * 86400, "d")
          Column {
            weight: 1
            align: center
            justify: center
            gap: 4
            padding: [0, 8]
            radius: 12
            background: isToday ? c_pill_on : c_pill_off
            border: isToday ? 0 : 1
            borderColor: c_border
            Text {
              text: weekLabels[i]
              fontSize: 11
              bold: true
              align: center
              color: isToday ? "#000000" : c_text_sec
            }
            Text {
              text: dayDate
              fontSize: 13
              bold: isToday
              align: center
              color: isToday ? "#000000" : c_text_pri
            }
          }
        }
      }

      // Bottom Status Pills: Location/Condition & Genuine Next Alarm
      Row {
        fill: width
        gap: 8

        // Location & Condition Pill (Tap opens weather app, long-press/tap edit icon configures city)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: {
            haptic("light")
            androidApp("weather")
          }
          onLongPress: {
            haptic("medium")
            cityInput = city
            editCity = true
          }
          Text { text: "⌖"; fontSize: 11; align: center }
          Text {
            text: "${condText} • ${place}"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: c_text_pri
          }
          Text {
            text: "✎"
            fontSize: 10
            color: c_text_sec
            onTap: {
              haptic("light")
              cityInput = city
              editCity = true
            }
          }

          // City configuration popup
          Popup {
            visible: editCity
            onDismiss: {
              editCity = false
              cityInput = ""
            }
            width: screenWidth - 48
            padding: 16
            background: "#161618"
            radius: 20
            border: 1
            borderColor: c_rim
            Column {
              fill: width
              gap: 12
              Row {
                fill: width
                justify: spaceBetween
                align: center
                Text { text: "WEATHER LOCATION"; style: label; fontSize: 11; color: c_text_sec }
                Text {
                  text: "✕"
                  fontSize: 14
                  color: c_text_sec
                  onTap: {
                    editCity = false
                    cityInput = ""
                  }
                }
              }
              Text {
                text: "Enter city name or choose a preset (empty for Auto):"
                fontSize: 12
                color: c_text_sec
              }
              Row {
                fill: width
                align: center
                padding: [10, 8]
                radius: 12
                background: c_pill_off
                border: 1
                borderColor: c_border
                Input {
                  weight: 1
                  placeholder: "Leave blank for Auto IP/GPS..."
                  underline: false
                  color: c_text_pri
                  fontSize: 13
                  text: cityInput
                  onChange: cityInput = value
                  onSubmit: {
                    haptic("medium")
                    city = trim(value)
                    editCity = false
                    refresh
                  }
                }
              }
              Row {
                fill: width
                wrap: true
                gap: 6
                for loc in ["Auto (IP)", "Bengaluru", "Delhi", "Mumbai", "London", "San Francisco"] {
                  let val = loc == "Auto (IP)" ? "" : loc
                  let isSelected = city == val
                  Box {
                    padding: [6, 10]
                    radius: 10
                    background: isSelected ? c_pill_on : c_pill_off
                    border: isSelected ? 0 : 1
                    borderColor: c_border
                    onTap: {
                      haptic("light")
                      city = val
                      cityInput = val
                      editCity = false
                      refresh
                    }
                    Text {
                      text: loc
                      fontSize: 11
                      bold: isSelected
                      color: isSelected ? "#000000" : c_text_pri
                    }
                  }
                }
              }
              Row {
                fill: width
                justify: flexEnd
                gap: 8
                Box {
                  padding: [8, 14]
                  radius: 10
                  background: c_pill_off
                  onTap: {
                    editCity = false
                    cityInput = ""
                  }
                  Text { text: "Cancel"; fontSize: 12; color: c_text_sec }
                }
                Box {
                  padding: [8, 14]
                  radius: 10
                  background: c_pill_on
                  onTap: {
                    haptic("medium")
                    city = trim(cityInput)
                    editCity = false
                    refresh
                  }
                  Text { text: "Save"; fontSize: 12; bold: true; color: "#000000" }
                }
              }
            }
          }
        }

        // Alarm Pill (Reads genuine Android system next-alarm broadcast/API)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: {
            haptic("light")
            androidApp("clock")
          }
          Text { text: "⏰"; fontSize: 11; align: center }
          Text {
            text: alarm.set ? fmtTime(alarm.time, "EEE HH:mm") : "No alarm set"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: alarm.set ? c_text_pri : c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 3. SAMSUNG-STYLE QUICK CONTROLS ICONS
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 14

      Row {
        fill: width
        align: center
        Text {
          text: "QUICK CONTROLS"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: showMoreControls ? "▲ LESS" : "▼ MORE"
          style: label
          fontSize: 10
          color: c_text_sec
          onTap: {
            haptic("light")
            showMoreControls = !showMoreControls
          }
        }
      }

      // Samsung Notification Panel Circular Icon Toggles
      Row {
        fill: width
        align: center
        justify: spaceEvenly

        // 1. Torch
        let torchOn = modes.torch == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); torch("toggle") }
          Box {
            size: 48
            radius: 24
            background: torchOn ? c_pill_on : c_pill_off
            border: torchOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "ϟ"
              fontSize: 20
              bold: true
              align: center
              color: torchOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "Torch"
            fontSize: 10
            bold: true
            color: torchOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 2. Sound / Mute
        let isMuted = vol.muted || (vol.level ?? 0) == 0
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); volume("toggle") }
          Box {
            size: 48
            radius: 24
            background: !isMuted ? c_pill_on : c_pill_off
            border: !isMuted ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: isMuted ? "✕" : "♪"
              fontSize: 20
              bold: true
              align: center
              color: !isMuted ? "#000000" : c_text_pri
            }
          }
          Text {
            text: isMuted ? "Mute" : "Sound"
            fontSize: 10
            bold: true
            color: !isMuted ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 3. DND
        let dndOn = modes.dnd == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); dnd("toggle") }
          Box {
            size: 48
            radius: 24
            background: dndOn ? c_pill_on : c_pill_off
            border: dndOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "☾︎"
              fontSize: 20
              align: center
              color: dndOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "DND"
            fontSize: 10
            bold: true
            color: dndOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 4. Wi-Fi
        let wifiOn = modes.wifi == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); settings("wifi") }
          Box {
            size: 48
            radius: 24
            background: wifiOn ? c_pill_on : c_pill_off
            border: wifiOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "≋"
              fontSize: 20
              bold: true
              align: center
              color: wifiOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "Wi-Fi"
            fontSize: 10
            bold: true
            color: wifiOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 5. Bluetooth
        let btOn = modes.bluetooth == true
        Column {
          align: center
          gap: 6
          onTap: { haptic("light"); settings("bluetooth") }
          Box {
            size: 48
            radius: 24
            background: btOn ? c_pill_on : c_pill_off
            border: btOn ? 0 : 1
            borderColor: c_border
            align: center
            Text {
              text: "ᛒ"
              fontSize: 20
              bold: true
              align: center
              color: btOn ? "#000000" : c_text_pri
            }
          }
          Text {
            text: "Bluetooth"
            fontSize: 10
            bold: true
            color: btOn ? c_text_pri : c_text_sec
            align: center
          }
        }

        // 6. Terminal / btop
        Column {
          align: center
          gap: 6
          onTap: { haptic("medium"); terminal("btop") }
          Box {
            size: 48
            radius: 24
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text {
              text: ">_"
              fontSize: 16
              bold: true
              align: center
              color: c_text_pri
            }
          }
          Text {
            text: "Terminal"
            fontSize: 10
            bold: true
            color: c_text_sec
            align: center
          }
        }
      }

      // Secondary Quick Controls (Expanded row: Airplane, Dark Theme, Battery Saver, Audio Output Switcher, Internet Panel)
      if showMoreControls {
        Row {
          fill: width
          align: center
          justify: spaceEvenly

          // 7. Airplane Mode
          let airOn = modes.airplane == true
          Column {
            align: center
            gap: 6
            onTap: { haptic("light"); settings("airplane") }
            Box {
              size: 48
              radius: 24
              background: airOn ? c_pill_on : c_pill_off
              border: airOn ? 0 : 1
              borderColor: c_border
              align: center
              Text {
                text: "✈"
                fontSize: 18
                align: center
                color: airOn ? "#000000" : c_text_pri
              }
            }
            Text {
              text: "Airplane"
              fontSize: 10
              bold: true
              color: airOn ? c_text_pri : c_text_sec
              align: center
            }
          }

          // 8. Dark Mode
          let darkOn = modes.dark == true
          Column {
            align: center
            gap: 6
            onTap: { haptic("light"); settings("dark") }
            Box {
              size: 48
              radius: 24
              background: darkOn ? c_pill_on : c_pill_off
              border: darkOn ? 0 : 1
              borderColor: c_border
              align: center
              Text {
                text: "◐"
                fontSize: 18
                bold: true
                align: center
                color: darkOn ? "#000000" : c_text_pri
              }
            }
            Text {
              text: "Theme"
              fontSize: 10
              bold: true
              color: darkOn ? c_text_pri : c_text_sec
              align: center
            }
          }

          // 9. Battery Saver
          let saverOn = modes.saver == true
          Column {
            align: center
            gap: 6
            onTap: { haptic("light"); settings("battery") }
            Box {
              size: 48
              radius: 24
              background: saverOn ? c_pill_on : c_pill_off
              border: saverOn ? 0 : 1
              borderColor: c_border
              align: center
              Text {
                text: "⚡"
                fontSize: 18
                bold: true
                align: center
                color: saverOn ? "#000000" : c_text_pri
              }
            }
            Text {
              text: "Saver"
              fontSize: 10
              bold: true
              color: saverOn ? c_text_pri : c_text_sec
              align: center
            }
          }

          // 10. Output Switcher
          Column {
            align: center
            gap: 6
            onTap: { haptic("light"); settings("output") }
            Box {
              size: 48
              radius: 24
              background: c_pill_off
              border: 1
              borderColor: c_border
              align: center
              Text {
                text: "⎋"
                fontSize: 18
                bold: true
                align: center
                color: c_text_pri
              }
            }
            Text {
              text: "Output"
              fontSize: 10
              bold: true
              color: c_text_sec
              align: center
            }
          }

          // 11. Network / Internet
          Column {
            align: center
            gap: 6
            onTap: { haptic("light"); settings("internet") }
            Box {
              size: 48
              radius: 24
              background: c_pill_off
              border: 1
              borderColor: c_border
              align: center
              Text {
                text: "☵"
                fontSize: 18
                bold: true
                align: center
                color: c_text_pri
              }
            }
            Text {
              text: "Network"
              fontSize: 10
              bold: true
              color: c_text_sec
              align: center
            }
          }
        }
      }

      // Media Volume Slider Bar
      Column {
        fill: width
        gap: 4
        Row {
          fill: width
          align: center
          Text { text: "VOLUME LEVEL"; fontSize: 10; color: c_text_sec; weight: 1 }
          Text { text: "${vol.level ?? 0}%"; fontSize: 11; bold: true; color: c_text_pri }
        }
        Slider {
          value: vol.level ?? 0
          min: 0
          max: 100
          live: true
          fill: width
          color: c_text_pri
          track: "#2C2C2E"
          onChange: volume(value)
        }
      }
    }

    // ==========================================
    // 4. FAVORITE APPS: editable (long-press a tile or tap EDIT)
    // ==========================================
    AppSection {
      sec: "fav"
      title: "FAVORITE APPS"
      defaults: ["com.whatsapp", "com.instagram.android", "Phone", "Messages", "com.brave.browser", "Camera"]
      cols: 4
      compact: true
    }

    // ==========================================
    // 5. COMPACT DEVICE & NETWORK TELEMETRY
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text {
          text: "DEVICE & NETWORK TELEMETRY"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: "REAL-TIME"
          style: label
          fontSize: 10
          color: c_text_sec
        }
      }

      // Compact Telemetry Metrics Row
      Row {
        fill: width
        gap: 8

        // Battery Chip
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: bat.charging ? "ϟ" : "▮"; fontSize: 16; align: center }
          Column {
            gap: 1
            Text { text: batText; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: bat.charging ? "Charging" : "Battery"; fontSize: 9; color: c_text_sec }
          }
        }

        // Network Speed (Download)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "↓"; fontSize: 16; bold: true; color: c_text_pri; align: center }
          Column {
            gap: 1
            Text { text: "${fmtBytes(netDown)}/s"; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: "Down speed"; fontSize: 9; color: c_text_sec }
          }
        }

        // RAM Memory Chip
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "▦"; fontSize: 16; align: center }
          Column {
            gap: 1
            Text { text: memText; fontSize: 12; bold: true; color: c_text_pri }
            Text { text: "RAM used"; fontSize: 9; color: c_text_sec }
          }
        }
      }

      // Secondary Telemetry Metrics Row
      Row {
        fill: width
        gap: 8

        // Storage Free
        Row {
          weight: 1
          padding: [8, 8]
          radius: 10
          background: c_bg
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "◫"; fontSize: 12; align: center }
          Text { text: "Storage: ${fmtBytes(storFree)} free"; fontSize: 10; color: c_text_sec; weight: 1 }
        }

        // Network Upload
        Row {
          weight: 1
          padding: [8, 8]
          radius: 10
          background: c_bg
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          Text { text: "⬆"; fontSize: 12; align: center }
          Text { text: "Upload: ${fmtBytes(netUp)}/s"; fontSize: 10; color: c_text_sec; weight: 1 }
        }
      }
    }

    // ==========================================
    // 5. COMPACT NOTIFICATIONS FEED CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      // Header: Bell Icon, Title, Unread Count Pill
      Row {
        fill: width
        align: center
        Text {
          text: "NOTIFICATIONS"
          style: label
          fontSize: 11
          color: c_text_pri
          weight: 1
        }
        Row {
          padding: [8, 4]
          radius: 10
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          Text {
            text: "${len(notifs.items ?? [])} unread"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }
      }

      // Stacked Notification Rows
      let notifList = (notifs.items ?? []).take(3)
      if len(notifList) == 0 {
        Text {
          text: "All caught up • No notifications"
          fontSize: 12
          color: c_text_sec
          padding: [0, 4]
        }
      } else {
        Column {
          fill: width
          gap: 10
          for nItem in notifList key nItem.key {
            Row {
              fill: width
              align: center
              gap: 10
              padding: [6, 4]
              offset: [dragging == nItem.key ? dragX : 0, 0]
              animate offset: spring(0.8, 400)
              opacity: dragging == nItem.key ? max(0.2, 1 - abs(dragX) / 250) : 1
              drag: horizontal
              onDrag: {
                if nItem.clearable {
                  dragging = nItem.key
                  dragX = dragX + dx
                }
              }
              onDragEnd: {
                if dragging == nItem.key && (abs(dragX) > 80 || abs(vx) > 800) {
                  swiped = nItem.key
                  notification("dismiss", nItem.key)
                }
                dragging = ""
                dragX = 0
              }
              onTap: notification("open", nItem.key)

              // App Icon / Glyph
              Image {
                src: nItem.icon
                size: 32
                radius: 8
              }

              // Text preview
              Column {
                weight: 1
                gap: 2
                Text {
                  text: nItem.title ?? "Alert"
                  fontSize: 13
                  bold: true
                  maxLines: 1
                  color: c_text_pri
                }
                Text {
                  text: nItem.text ?? ""
                  fontSize: 11
                  maxLines: 1
                  color: c_text_sec
                }
              }

              // Relative timestamp
              Text {
                text: fmtAgo(nItem.time, now)
                fontSize: 10
                color: c_text_sec
              }
            }
          }
        }
      }
    }

    // ==========================================
    // 6. QUICK LAUNCH DOCK (PLAYER, APPS & WORK)
    // ==========================================
    Row {
      fill: width
      gap: 8

      // Music Player Button (Page -1)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:-2")
        }
        Text {
          text: "♪"
          fontSize: 14
          align: center
        }
        Text {
          text: "PLAYER"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // All Apps Drawer Launcher Button
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_pill_on
        onTap: {
          haptic("medium")
          launcher("drawer")
        }
        Text {
          text: "⊞"
          fontSize: 15
          bold: true
          align: center
          color: "#000000"
        }
        Text {
          text: "ALL APPS"
          fontSize: 11
          bold: true
          align: center
          color: "#000000"
        }
      }

      // Work & Uni Workspace Button (Page 0)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:0")
        }
        Text {
          text: "▤"
          fontSize: 14
          align: center
        }
        Text {
          text: "WORK"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }
    }

    // Bottom Navigation Bar Spacing
    Spacer { height: screenInset + 12 }
  }
}
