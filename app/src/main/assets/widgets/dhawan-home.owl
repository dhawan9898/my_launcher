face "dhawan-home" {
  meta {
    owl: 23
    description: "Vantablack OLED Main Home Dashboard"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  page: 0
  statusBar: false

  // --- Real-time Device & Environment Sources ---
  source now = clock every 1m
  source sys = android.system every 5s
  source bat = android.battery
  source alarm = android.alarm
  source modes = android.modes
  source vol = android.volume
  source wx = http("https://wttr.in/Bengaluru?format=j1") every 30m timeout 10s json
  source notifs = android.notifications

  // --- Vantablack High-Contrast Monochrome Design Tokens ---
  let c_bg = "#000000"
  let c_card = "#121214"
  let c_border = "#262629"
  let c_pill_off = "#1C1C1E"
  let c_pill_on = "#FFFFFF"
  let c_text_pri = "#FFFFFF"
  let c_text_sec = "#8E8E93"

  // --- Dynamic Greeting & Time Computations ---
  let hr = num(fmtTime(now, "H"))
  let greet = hr < 12 ? "Good morning" : hr < 17 ? "Good afternoon" : hr < 21 ? "Good evening" : "Good night"
  let upSec = sys.uptime ?? 3600
  let upHours = floor(upSec / 3600)
  let upMins = floor((upSec % 3600) / 60)
  let uptimeStr = "${upHours}h ${upMins}m"

  // Weather extraction
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let place = wx.nearest_area[0].areaName[0].value ?? "Bengaluru"
  let tempC = cur ? cur.temp_C : "26"
  let condText = cur ? cur.weatherDesc[0].value : "Sunny"
  let tempMax = day ? day.maxtempC : "30"
  let tempMin = day ? day.mintempC : "20"

  // Calendar week calculations (7 days: Monday to Sunday)
  let dayName = fmtTime(now, "E", null, "en")
  let dayOfWeek = dayName == "Mon" ? 0 : dayName == "Tue" ? 1 : dayName == "Wed" ? 2 : dayName == "Thu" ? 3 : dayName == "Fri" ? 4 : dayName == "Sat" ? 5 : 6
  let weekLabels = ["M", "T", "W", "T", "F", "S", "S"]

  // Telemetry ratios
  let batLevel = bat.level ?? 85
  let memTotal = sys.memory.total ?? 1
  let memUsed = sys.memory.used ?? 0
  let memRatio = memTotal > 0 ? (memUsed / memTotal) : 0.45
  let memPct = round(memRatio * 100)

  let storTotal = sys.storage.total ?? 1
  let storFree = sys.storage.free ?? 0
  let storUsed = storTotal - storFree
  let storRatio = storTotal > 0 ? (storUsed / storTotal) : 0.60
  let storPct = round(storRatio * 100)

  // Customizable Quick Toggles Configuration (Persisted across restarts, editable manually without agent)
  state cfg_customizing = false
  state show_add_catalog = false
  state user_toggles = ["torch", "volume", "dnd", "wifi", "btop", "bluetooth"] persist
  state toggle_cols = 3 persist

  background: c_bg
  padding: [16, 20, 16, 20]

  Column {
    gap: 14
    fill: width
    scroll: true

    // ==========================================
    // 1. TOP GREETING HEADER
    // ==========================================
    Row {
      fill: width
      align: center
      gap: 12

      // Circular "D" avatar badge
      Box {
        size: 42
        radius: 21
        background: c_card
        border: 1
        borderColor: c_border
        align: center
        Text {
          text: "D"
          fontSize: 18
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // Greeting and dynamic uptime subtitle
      Column {
        weight: 1
        gap: 2
        Text {
          text: greet
          fontSize: 16
          bold: true
          color: c_text_pri
        }
        Text {
          text: "Dhawan • up ${uptimeStr}"
          fontSize: 12
          color: c_text_sec
        }
      }

      // Top Action Buttons: Music Player, Work, All Apps & Settings
      Row {
        gap: 6
        align: center

        // Music Player Trigger (Page -1)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:-1")
          }
          Text {
            text: "🎵"
            fontSize: 14
            align: center
          }
        }

        // Work & Uni Workspace Trigger (Page 1)
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:1")
          }
          Text {
            text: "💼"
            fontSize: 14
            align: center
          }
        }

        // All Apps Drawer Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("drawer")
          }
          Text {
            text: "⊞"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }

        // Settings & Customization Gear Trigger
        Box {
          size: 38
          radius: 19
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("settings")
          }
          Text {
            text: "⚙"
            fontSize: 16
            align: center
            color: c_text_pri
          }
        }
      }
    }

    // ==========================================
    // 2. CLOCK, WEATHER & WEEK STRIP CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 18
      gap: 14

      // Top Row: Big Digital Clock & Live Weather Readout
      Row {
        fill: width
        align: center

        // Clock Block -> Tapping opens Clock/Alarm app
        Column {
          weight: 1
          gap: 2
          onTap: androidApp(alarm.app ?? "com.sec.android.app.clockpackage")
          Text {
            spans: [
              fmtTime(now, "HH"),
              { text: ":", color: c_text_sec },
              fmtTime(now, "mm")
            ]
            fontSize: 48
            bold: true
            letterSpacing: -2
            color: c_text_pri
          }
          Text {
            text: fmtTime(now, "EEEE, d MMMM")
            fontSize: 13
            color: c_text_sec
          }
        }

        // Weather Block -> Tapping opens Weather
        Column {
          align: end
          gap: 2
          onTap: androidApp("com.sec.android.daemonapp")
          Text {
            text: "${tempC}°"
            fontSize: 34
            bold: true
            color: c_text_pri
          }
          Text {
            text: condText
            fontSize: 12
            bold: true
            color: c_text_sec
          }
          Text {
            text: "↑${tempMax}° ↓${tempMin}°"
            fontSize: 11
            color: c_text_sec
          }
        }
      }

      // 7-Day Horizontal Calendar Strip (Highlights today in solid white pill)
      Row {
        fill: width
        align: center
        gap: 6
        onTap: calendar("open")
        for i in range(7) {
          let isToday = i == dayOfWeek
          let dayDate = fmtTime(now + (i - dayOfWeek) * 86400, "d")
          Column {
            weight: 1
            align: center
            justify: center
            gap: 4
            padding: [0, 8]
            radius: 12
            background: isToday ? c_pill_on : c_pill_off
            border: isToday ? 0 : 1
            borderColor: c_border
            Text {
              text: weekLabels[i]
              fontSize: 11
              bold: true
              align: center
              color: isToday ? "#000000" : c_text_sec
            }
            Text {
              text: dayDate
              fontSize: 13
              bold: isToday
              align: center
              color: isToday ? "#000000" : c_text_pri
            }
          }
        }
      }

      // Bottom Status Pills: Location/Condition & Genuine Next Alarm
      Row {
        fill: width
        gap: 8

        // Location & Condition Pill
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: androidApp("com.sec.android.daemonapp")
          Text { text: "📍"; fontSize: 11; align: center }
          Text {
            text: "${condText} • ${place}"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: c_text_pri
          }
        }

        // Alarm Pill (Reads genuine Android system next-alarm broadcast/API)
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          gap: 6
          onTap: androidApp(alarm.app ?? "com.sec.android.app.clockpackage")
          Text { text: "⏰"; fontSize: 11; align: center }
          Text {
            text: alarm.set ? fmtTime(alarm.time, "EEE HH:mm") : "No alarm set"
            fontSize: 11
            bold: true
            maxLines: 1
            weight: 1
            color: alarm.set ? c_text_pri : c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 3. QUICK TOGGLES & MEDIA SLIDER CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      // Header: Title & Customize Trigger
      Row {
        fill: width
        align: center
        Text {
          text: cfg_customizing ? "CUSTOMIZE TOGGLES" : "QUICK CONTROLS"
          style: label
          fontSize: 11
          color: cfg_customizing ? c_text_pri : c_text_sec
          bold: cfg_customizing
          weight: 1
        }
        Row {
          gap: 6
          align: center
          padding: [8, 4]
          radius: 8
          background: cfg_customizing ? c_pill_on : c_pill_off
          border: cfg_customizing ? 0 : 1
          borderColor: c_border
          onTap: {
            haptic("light")
            cfg_customizing = !cfg_customizing
            if !cfg_customizing { show_add_catalog = false }
          }
          Text {
            text: cfg_customizing ? "✓" : "✦"
            fontSize: 10
            color: cfg_customizing ? "#000000" : c_text_pri
          }
          Text {
            text: cfg_customizing ? "DONE" : "CUSTOMIZE"
            style: label
            fontSize: 10
            bold: true
            color: cfg_customizing ? "#000000" : c_text_pri
          }
        }
      }

      // Customization Controls: Size Selector (Samsung Quick Panel 2/3/4 cols) & Add Catalog
      if cfg_customizing {
        Column {
          fill: width
          gap: 8
          padding: [8, 8]
          radius: 10
          background: c_bg
          border: 1
          borderColor: c_border

          // Size Switcher Row
          Row {
            fill: width
            align: center
            gap: 6
            Text {
              text: "GRID SIZE:"
              style: label
              fontSize: 10
              color: c_text_sec
              weight: 1
            }
            Row {
              padding: [6, 4]
              radius: 6
              background: toggle_cols == 2 ? c_pill_on : c_pill_off
              onTap: { haptic("light"); toggle_cols = 2 }
              Text {
                text: "2 Large"
                fontSize: 10
                bold: true
                color: toggle_cols == 2 ? "#000000" : c_text_sec
              }
            }
            Row {
              padding: [6, 4]
              radius: 6
              background: toggle_cols == 3 ? c_pill_on : c_pill_off
              onTap: { haptic("light"); toggle_cols = 3 }
              Text {
                text: "3 Normal"
                fontSize: 10
                bold: true
                color: toggle_cols == 3 ? "#000000" : c_text_sec
              }
            }
            Row {
              padding: [6, 4]
              radius: 6
              background: toggle_cols == 4 ? c_pill_on : c_pill_off
              onTap: { haptic("light"); toggle_cols = 4 }
              Text {
                text: "4 Compact"
                fontSize: 10
                bold: true
                color: toggle_cols == 4 ? "#000000" : c_text_sec
              }
            }
          }

          // Action Buttons: Add & Reset
          Row {
            fill: width
            gap: 6
            Row {
              weight: 1
              align: center
              justify: center
              gap: 4
              padding: [6, 6]
              radius: 6
              background: show_add_catalog ? c_pill_on : c_pill_off
              border: 1
              borderColor: c_border
              onTap: { haptic("light"); show_add_catalog = !show_add_catalog }
              Text {
                text: show_add_catalog ? "▲ Close Menu" : "➕ Add New Toggle"
                fontSize: 10
                bold: true
                color: show_add_catalog ? "#000000" : c_text_pri
              }
            }
            Row {
              padding: [6, 6]
              radius: 6
              background: c_pill_off
              border: 1
              borderColor: c_border
              onTap: {
                haptic("medium")
                user_toggles = ["torch", "volume", "dnd", "wifi", "btop", "bluetooth"]
                toggle_cols = 3
              }
              Text {
                text: "↺ Reset"
                fontSize: 10
                color: c_text_sec
              }
            }
          }

          // Catalog of Available Toggles
          if show_add_catalog {
            Flow {
              fill: width
              gap: 6
              for catId in ["torch", "volume", "dnd", "wifi", "btop", "bluetooth", "airplane", "dark", "rotate", "saver", "hotspot", "nfc"] {
                Row {
                  gap: 4
                  align: center
                  padding: [6, 4]
                  radius: 6
                  background: c_pill_off
                  border: 1
                  borderColor: c_border
                  onTap: {
                    haptic("light")
                    user_toggles = user_toggles + [catId]
                  }
                  Text {
                    text: "+ " + catId
                    fontSize: 10
                    bold: true
                    color: c_text_pri
                  }
                }
              }
            }
          }
        }
      }

      // Dynamic Auto-Resizing Grid of Toggles
      Column {
        fill: width
        gap: 8

        for rowItems, rowIdx in chunk(user_toggles, toggle_cols) {
          Row {
            fill: width
            gap: 8

            for tId, colIdx in rowItems {
              let globalIdx = rowIdx * toggle_cols + colIdx
              let isTorch = tId == "torch"
              let isVol = tId == "volume"
              let isDnd = tId == "dnd"
              let isWifi = tId == "wifi"
              let isBtop = tId == "btop"
              let isBt = tId == "bluetooth"
              let isAir = tId == "airplane"
              let isDark = tId == "dark"
              let isRot = tId == "rotate"
              let isSav = tId == "saver"
              let isHot = tId == "hotspot"
              let isNfc = tId == "nfc"

              let isActive = isTorch ? (modes.torch == true) : isVol ? (!vol.muted && (vol.level ?? 0) > 0) : isDnd ? (modes.dnd == true) : isWifi ? (modes.wifi == true) : isBt ? (modes.bluetooth == true) : isAir ? (modes.airplane == true) : isDark ? (modes.dark == true) : isRot ? (modes.rotate == true) : isSav ? (modes.saver == true) : false

              let tIcon = isTorch ? "🔦" : isVol ? ((vol.level ?? 0) > 0 && !vol.muted ? "🔊" : "🔇") : isDnd ? "🌙" : isWifi ? "📶" : isBtop ? "💻" : isBt ? "ᛒ" : isAir ? "✈" : isDark ? "◐" : isRot ? "⟲" : isSav ? "⚡" : isHot ? "📡" : isNfc ? "📳" : "⚙"

              let tLabel = isTorch ? (isActive ? "Torch On" : "Torch") : isVol ? (vol.muted ? "Muted" : "${vol.level ?? 0}%") : isDnd ? (isActive ? "DND On" : "DND") : isWifi ? (isActive ? "Wi-Fi On" : "Wi-Fi") : isBtop ? "btop" : isBt ? (isActive ? "BT On" : "Bluetooth") : isAir ? (isActive ? "Flight On" : "Airplane") : isDark ? (isActive ? "Dark On" : "Dark") : isRot ? (isActive ? "Auto-Rot" : "Rotate") : isSav ? (isActive ? "Saver On" : "Battery") : isHot ? "Hotspot" : isNfc ? "NFC" : tId

              Column {
                weight: 1
                padding: toggle_cols == 2 ? [12, 12] : toggle_cols == 4 ? [8, 6] : [10, 10]
                radius: 12
                background: (!cfg_customizing && isActive) ? c_pill_on : c_pill_off
                border: (!cfg_customizing && isActive) ? 0 : 1
                borderColor: c_border
                align: center
                justify: center
                gap: 4
                onTap: {
                  haptic("light")
                  if cfg_customizing {
                    user_toggles = remove(user_toggles, globalIdx)
                  } else if isTorch {
                    torch("toggle")
                  } else if isVol {
                    volume("toggle")
                  } else if isDnd {
                    dnd("toggle")
                  } else if isWifi {
                    settings("wifi")
                  } else if isBtop {
                    terminal("btop")
                  } else if isBt {
                    settings("bluetooth")
                  } else if isAir {
                    settings("airplane")
                  } else if isDark {
                    settings("dark")
                  } else if isRot {
                    settings("display")
                  } else if isSav {
                    settings("battery")
                  } else if isHot {
                    settings("internet")
                  } else if isNfc {
                    settings("nfc")
                  }
                }

                Row {
                  align: center
                  justify: center
                  gap: 4
                  Text {
                    text: tIcon
                    fontSize: toggle_cols == 2 ? 18 : toggle_cols == 4 ? 13 : 15
                    align: center
                    color: (!cfg_customizing && isActive) ? "#000000" : c_text_pri
                  }
                  if cfg_customizing {
                    Text {
                      text: "✕"
                      fontSize: 10
                      bold: true
                      color: "#FF453A"
                    }
                  }
                }
                Text {
                  text: tLabel
                  fontSize: toggle_cols == 2 ? 12 : toggle_cols == 4 ? 9 : 11
                  bold: true
                  align: center
                  maxLines: 1
                  color: (!cfg_customizing && isActive) ? "#000000" : c_text_pri
                }
              }
            }
          }
        }
      }

      // Full-Width Media Volume Slider Bar
      Column {
        fill: width
        gap: 4
        Row {
          fill: width
          align: center
          Text { text: "VOLUME LEVEL"; fontSize: 10; color: c_text_sec; weight: 1 }
          Text { text: "${vol.level ?? 0}%"; fontSize: 11; bold: true; color: c_text_pri }
        }
        Slider {
          value: vol.level ?? 0
          min: 0
          max: 100
          live: true
          fill: width
          color: c_text_pri
          track: "#2C2C2E"
          onChange: volume(value)
        }
      }
    }

    // ==========================================
    // 4. CIRCULAR TELEMETRY RINGS CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 14

      Text {
        text: "DEVICE TELEMETRY"
        style: label
        fontSize: 11
        color: c_text_sec
      }

      Row {
        fill: width
        align: center
        gap: 8

        // Battery Ring
        Column {
          weight: 1
          align: center
          justify: center
          gap: 8
          Box {
            size: 68
            align: center
            Ring {
              value: batLevel / 100
              size: 68
              thickness: 6
              color: c_text_pri
              track: c_pill_off
            }
            Text {
              text: "${batLevel}%"
              fontSize: 14
              bold: true
              align: center
              color: c_text_pri
            }
          }
          Text {
            text: bat.charging ? "CHARGING" : "BATTERY"
            fontSize: 10
            bold: true
            align: center
            color: c_text_sec
          }
        }

        // Memory (RAM) Ring
        Column {
          weight: 1
          align: center
          justify: center
          gap: 8
          Box {
            size: 68
            align: center
            Ring {
              value: memRatio
              size: 68
              thickness: 6
              color: c_text_pri
              track: c_pill_off
            }
            Text {
              text: "${memPct}%"
              fontSize: 14
              bold: true
              align: center
              color: c_text_pri
            }
          }
          Text {
            text: "RAM"
            fontSize: 10
            bold: true
            align: center
            color: c_text_sec
          }
        }

        // Storage Ring
        Column {
          weight: 1
          align: center
          justify: center
          gap: 8
          Box {
            size: 68
            align: center
            Ring {
              value: storRatio
              size: 68
              thickness: 6
              color: c_text_pri
              track: c_pill_off
            }
            Text {
              text: "${storPct}%"
              fontSize: 14
              bold: true
              align: center
              color: c_text_pri
            }
          }
          Text {
            text: "STORAGE"
            fontSize: 10
            bold: true
            align: center
            color: c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 5. COMPACT NOTIFICATIONS FEED CARD
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      // Header: Bell Icon, Title, Unread Count Pill
      Row {
        fill: width
        align: center
        Text {
          text: "🔔  NOTIFICATIONS"
          style: label
          fontSize: 11
          color: c_text_pri
          weight: 1
        }
        Row {
          padding: [8, 4]
          radius: 10
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          Text {
            text: "${len(notifs.items ?? [])} unread"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }
      }

      // Stacked Notification Rows
      let notifList = (notifs.items ?? []).take(3)
      if len(notifList) == 0 {
        Text {
          text: "All caught up • No notifications"
          fontSize: 12
          color: c_text_sec
          padding: [0, 4]
        }
      } else {
        Column {
          fill: width
          gap: 10
          for nItem in notifList key nItem.key {
            Row {
              fill: width
              align: center
              gap: 10
              padding: [6, 4]
              onTap: notification("open", nItem.key)

              // App Icon / Glyph
              Image {
                src: nItem.icon
                size: 32
                radius: 8
              }

              // Text preview
              Column {
                weight: 1
                gap: 2
                Text {
                  text: nItem.title ?? "Alert"
                  fontSize: 13
                  bold: true
                  maxLines: 1
                  color: c_text_pri
                }
                Text {
                  text: nItem.text ?? ""
                  fontSize: 11
                  maxLines: 1
                  color: c_text_sec
                }
              }

              // Relative timestamp
              Text {
                text: fmtAgo(nItem.time, now)
                fontSize: 10
                color: c_text_sec
              }
            }
          }
        }
      }
    }

    // ==========================================
    // 6. QUICK LAUNCH DOCK (PLAYER, APPS & WORK)
    // ==========================================
    Row {
      fill: width
      gap: 8

      // Music Player Button (Page -1)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:-1")
        }
        Text {
          text: "🎵"
          fontSize: 14
          align: center
        }
        Text {
          text: "PLAYER"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }

      // All Apps Drawer Launcher Button
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_pill_on
        onTap: {
          haptic("medium")
          launcher("drawer")
        }
        Text {
          text: "⊞"
          fontSize: 15
          bold: true
          align: center
          color: "#000000"
        }
        Text {
          text: "ALL APPS"
          fontSize: 11
          bold: true
          align: center
          color: "#000000"
        }
      }

      // Work & Uni Workspace Button (Page 1)
      Row {
        weight: 1
        align: center
        justify: center
        gap: 6
        padding: [12, 10]
        radius: 14
        background: c_card
        border: 1
        borderColor: c_border
        onTap: {
          haptic("light")
          launcher("page:1")
        }
        Text {
          text: "💼"
          fontSize: 14
          align: center
        }
        Text {
          text: "WORK"
          fontSize: 11
          bold: true
          align: center
          color: c_text_pri
        }
      }
    }

    // Bottom Navigation Bar Spacing
    Spacer { height: screenInset + 12 }
  }
}
