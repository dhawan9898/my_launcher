face "dhawan-media" {
  meta {
    owl: 23
    description: "Vantablack OLED Full-Screen Media Hub"
    version: "1.0"
    license: "MIT"
    category: "media"
  }

  page: -2
  statusBar: false

  // --- Real-time Android Media & Audio Sources ---
  source m = android.media
  source vol = android.volume
  source now = clock every 1s

  // --- Vantablack High-Contrast Monochrome Design Tokens ---
  let c_bg = "#000000"
  let c_card = "#121214"
  let c_border = "#262629"
  let c_pill_off = "#1C1C1E"
  let c_pill_on = "#FFFFFF"
  let c_text_pri = "#FFFFFF"
  let c_text_sec = "#8E8E93"

  // Playback state extraction
  let isPlaying = m != null && m.playing == true
  let hasTrack = m != null && m.title != null && m.title != ""
  let trackTitle = hasTrack ? m.title : "No Media Playing"
  let trackArtist = (m != null && m.artist != null && m.artist != "") ? m.artist : "Select audio from a player below"
  let sourceApp = (m != null && m.app != null && m.app != "") ? m.app : "MEDIA HUB"
  let pos = m != null ? (m.position ?? 0) : 0
  let dur = m != null ? (m.duration ?? 0) : 0
  // No length (nothing playing, a live stream): no made-up time left, and nothing to drag.
  let hasDur = dur > 0
  let safeDur = hasDur ? dur : 1
  let remaining = safeDur > pos ? (safeDur - pos) : 0
  let canSeek = hasDur && m != null && m.canSeek == true
  let played = hasDur ? max(0.001, min(0.999, pos / safeDur)) : 0.001

  // Audio output device
  let outName = (vol != null && vol.output != null && vol.output.name != null && vol.output.name != "") ? vol.output.name : "Phone Speaker"
  let volPct = vol != null ? (vol.level ?? 0) : 0
  let volText = vol != null && vol.level != null ? "${vol.level}%" : "—"

  background: c_bg
  padding: [16, 20, 16, 20]

  Column {
    gap: 14
    fill: width
    scroll: true

    // Top Header: Navigation & Status
    Row {
      fill: width
      align: center
      Text {
        text: "MEDIA & SOUND HUB"
        style: label
        fontSize: 12
        bold: true
        color: c_text_sec
        weight: 1
      }
      Row {
        gap: 6
        align: center

        // All Apps Drawer Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("drawer")
          }
          Text {
            text: "⊞ APPS"
            fontSize: 10
            bold: true
            color: c_text_sec
          }
        }

        // Home Navigation Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:-1")
          }
          Text {
            text: "HOME ›"
            fontSize: 10
            bold: true
            color: c_text_pri
          }
        }

        // Work Navigation Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:0")
          }
          Text {
            text: "WORK ›"
            fontSize: 10
            bold: true
            color: c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 1. HERO NOW-PLAYING CARD (Top of screen)
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 24
      padding: 18
      gap: 16

      // Album Artwork / Audio Visualizer Frame
      Box {
        fill: width
        height: 240
        radius: 20
        background: "#08080A"
        border: 1
        borderColor: c_border
        align: center
        clip: true
        onTap: media("open")

        if m != null && m.art != null {
          Image {
            src: m.art
            fill: true
            fit: cover
            radius: 20
          }
        } else {
          // Monochrome Stylized Audio Canvas Frame
          Column {
            align: center
            justify: center
            gap: 10
            Text {
              text: isPlaying ? "🎵" : "🎧"
              fontSize: 48
              align: center
            }
            Text {
              text: isPlaying ? "PLAYING AUDIO" : "AUDIO READY"
              style: label
              fontSize: 11
              bold: true
              letterSpacing: 2
              align: center
              color: c_text_sec
            }
          }
        }
      }

      // Track Metadata & Source App Badge
      Column {
        fill: width
        gap: 4
        Row {
          fill: width
          align: center
          Text {
            text: trackTitle
            fontSize: 20
            bold: true
            color: c_text_pri
            weight: 1
            maxLines: 1
          }
          Row {
            padding: [8, 4]
            radius: 8
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text {
              text: sourceApp
              fontSize: 10
              bold: true
              color: c_text_sec
            }
          }
        }
        Text {
          text: trackArtist
          fontSize: 14
          color: c_text_sec
          maxLines: 1
        }
      }

      // Interactive Scrubber & Timestamps
      Column {
        fill: width
        gap: 2
        if canSeek {
          Slider {
            value: pos
            min: 0
            max: safeDur
            live: true
            fill: width
            color: c_text_pri
            track: "#2C2C2E"
            onChange: media("seek", value)
          }
        } else {
          // Progress only, for a player that can't seek: a slider here would snap back when dragged.
          Row {
            fill: width
            height: 28
            align: center
            Box { weight: played; height: 4; background: hasDur ? c_text_pri : "#2C2C2E" }
            Box { weight: 1 - played; height: 4; background: "#2C2C2E" }
          }
        }
        Row {
          fill: width
          Text {
            text: fmtTime(pos, "m:ss", "UTC")
            fontSize: 11
            color: c_text_sec
            weight: 1
          }
          Text {
            text: hasDur ? "-${fmtTime(remaining, 'm:ss', 'UTC')}" : "—"
            fontSize: 11
            color: c_text_sec
          }
        }
      }

      // Oversized Tactile Transport Controls
      Row {
        fill: width
        align: center
        justify: spaceEvenly

        // Shuffle Toggle
        Box {
          size: 46
          radius: 23
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("action", "shuffle")
          Text {
            text: "⇄"
            fontSize: 20
            bold: true
            align: center
            color: c_text_sec
          }
        }

        // Previous Track
        Box {
          size: 54
          radius: 27
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("previous")
          Text {
            text: "⏮"
            fontSize: 22
            align: center
            color: c_text_pri
          }
        }

        // Prominent Inverted White Play/Pause Button
        Box {
          size: 72
          radius: 36
          background: c_pill_on
          align: center
          onTap: media("toggle")
          Text {
            text: isPlaying ? "⏸" : "▶"
            fontSize: 28
            align: center
            color: "#000000"
          }
        }

        // Next Track
        Box {
          size: 54
          radius: 27
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("next")
          Text {
            text: "⏭"
            fontSize: 22
            align: center
            color: c_text_pri
          }
        }

        // Repeat Toggle
        Box {
          size: 46
          radius: 23
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("action", "repeat")
          Text {
            text: "↻"
            fontSize: 20
            bold: true
            align: center
            color: c_text_sec
          }
        }
      }

      // Output Device Switcher Pill
      Row {
        fill: width
        padding: [12, 10]
        radius: 14
        background: c_pill_off
        border: 1
        borderColor: c_border
        align: center
        gap: 8
        onTap: settings("output")
        Text { text: "🎧"; fontSize: 13; align: center }
        Text {
          text: "Audio Output:"
          fontSize: 12
          color: c_text_sec
        }
        Text {
          text: outName
          fontSize: 12
          bold: true
          color: c_text_pri
          weight: 1
        }
        Text {
          text: "SWITCH ›"
          fontSize: 10
          bold: true
          color: c_text_sec
        }
      }
    }

    // ==========================================
    // 2. MEDIA APPS & QUICK LAUNCH GRID
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Text {
        text: "STREAMING & MEDIA APPS"
        style: label
        fontSize: 11
        color: c_text_sec
      }

      // High-Contrast Monochrome Launch Tiles
      Row {
        fill: width
        gap: 8

        // yt-mini
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("yt-mini")
          Text {
            text: "▶"
            fontSize: 20
            align: center
            color: c_text_pri
          }
          Text {
            text: "yt-mini"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }

        // CineStream
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("cinestream")
          Text {
            text: "🎬"
            fontSize: 20
            align: center
          }
          Text {
            text: "CineStream"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }

        // AniStream
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("anistream")
          Text {
            text: "⛩"
            fontSize: 20
            align: center
          }
          Text {
            text: "AniStream"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }
      }

      Row {
        fill: width
        gap: 8

        // Netflix
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("com.netflix.mediaclient")
          Text {
            text: "🍿"
            fontSize: 20
            align: center
          }
          Text {
            text: "Netflix"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }

        // Gallery
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("gallery")
          Text {
            text: "🖼"
            fontSize: 20
            align: center
          }
          Text {
            text: "Gallery"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }

        // Photos
        Column {
          weight: 1
          padding: [10, 14]
          radius: 14
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: androidApp("photos")
          Text {
            text: "📷"
            fontSize: 20
            align: center
          }
          Text {
            text: "Photos"
            fontSize: 11
            bold: true
            align: center
            color: c_text_pri
          }
        }
      }
    }

    // ==========================================
    // 3. AUDIO & PLAYBACK QUICK CONTROLS (Bottom)
    // ==========================================
    Column {
      fill: width
      background: c_card
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text {
          text: "MASTER AUDIO VOLUME"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: volText
          fontSize: 12
          bold: true
          color: c_text_pri
        }
      }

      Slider {
        value: volPct
        min: 0
        max: 100
        live: true
        fill: width
        color: c_text_pri
        track: "#2C2C2E"
        onChange: volume(value)
      }

      Row {
        fill: width
        gap: 8

        // Quick Equalizer / Dolby Atmos Settings Pill
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: settings("sound")
          Text { text: "🎚"; fontSize: 12; align: center }
          Text {
            text: "Equalizer & Dolby"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }

        // Quick Volume Settings Sheet
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: settings("volume")
          Text { text: "🔊"; fontSize: 12; align: center }
          Text {
            text: "Sound Settings"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }
      }
    }

    // Bottom Navigation Bar Spacing
    Spacer { height: screenInset + 12 }
  }
}
