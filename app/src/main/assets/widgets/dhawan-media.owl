face "dhawan-media" {
  meta {
    owl: 26
    description: "Vantablack OLED Full-Screen Media Hub"
    version: "1.0"
    license: "MIT"
    category: "media"
  }

  page: -2
  statusBar: false

  // --- Real-time Android Media & Audio Sources ---
  source m = android.media
  source vol = android.volume
  source modes = android.modes
  source now = clock every 1s
  // Every app on the phone (Android, Linux and owl apps), for the editable app tiles and the app picker.
  source d = android.drawer

  // --- Responsive Transparent Glass & Frosted Glass Design Tokens (Dark / Light) ---
  let isDark = modes.dark != false
  let c_bg = isDark ? "#000000" : "#F4F4F6"
  let c_card = isDark ? alpha("#18181B", 0.65) : alpha("#FFFFFF", 0.70)
  let c_border = isDark ? alpha("#FFFFFF", 0.12) : alpha("#000000", 0.08)
  let c_pill_off = isDark ? alpha("#27272A", 0.60) : alpha("#E4E4E7", 0.75)
  let c_pill_on = isDark ? "#FFFFFF" : "#09090B"
  let c_text_pri = isDark ? "#FFFFFF" : "#09090B"
  let c_text_sec = isDark ? "#A1A1AA" : "#71717A"

  // --- Liquid glass: a pane lit from the top left, a bright rim, and a springy press ---
  let c_glass = isDark ? linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.12), alpha("#FFFFFF", 0.035)]) : linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.85), alpha("#FFFFFF", 0.50)])
  let c_glass_edit = isDark ? linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.20), alpha("#FFFFFF", 0.08)]) : linear(0, 0, 1, 1, [alpha("#FFFFFF", 0.95), alpha("#FFFFFF", 0.65)])
  let c_rim = isDark ? alpha("#FFFFFF", 0.16) : alpha("#000000", 0.12)
  let c_rim_edit = isDark ? alpha("#FFFFFF", 0.45) : alpha("#000000", 0.30)
  let c_clear = alpha("#000000", 0)
  let c_frost = 24

  // Playback state extraction
  let isPlaying = m != null && m.playing == true
  let hasTrack = m != null && m.title != null && m.title != ""
  let trackTitle = hasTrack ? m.title : "No Media Playing"
  let trackArtist = (m != null && m.artist != null && m.artist != "") ? m.artist : "Select audio from a player below"
  let sourceApp = (m != null && m.app != null && m.app != "") ? m.app : "MEDIA HUB"
  let pos = m != null ? (m.position ?? 0) : 0
  let dur = m != null ? (m.duration ?? 0) : 0
  // No length (nothing playing, a live stream): no made-up time left, and nothing to drag.
  let hasDur = dur > 0
  let safeDur = hasDur ? dur : 1
  let remaining = safeDur > pos ? (safeDur - pos) : 0
  let canSeek = hasDur && m != null && m.canSeek == true
  let played = hasDur ? max(0.001, min(0.999, pos / safeDur)) : 0.001

  // Audio output device
  let outName = (vol != null && vol.output != null && vol.output.name != null && vol.output.name != "") ? vol.output.name : "Phone Speaker"
  let volPct = vol != null ? (vol.level ?? 0) : 0
  let volText = vol != null && vol.level != null ? "${vol.level}%" : "—"

  // --- Editable app tiles & backup states ---
  // Each section's tiles, by section id: drawer keys once edited. Until then a section shows its defaults, given by
  // package name, which match that app's drawer key ("a:<package>/<activity>"), or by the app's name ("Phone").
  state tiles = {} persist
  // The section in edit mode, "" for none.
  state editing = ""
  // The app picker: the section and the tile it replaces, -1 to add one; "" while it's closed.
  state pickSec = ""
  state pickIdx = -1
  state query = ""
  // The node under the finger, for the press spring.
  state pressed = ""
  // Backup / Import state
  state importSec = false
  state importText = ""

  let allApps = d.apps ?? []
  let picks = query == "" ? take(allApps, 60) : take(rank(allApps, query), 40)

  // One app tile: the app's own icon as a white silhouette on glass. In edit mode a tap picks another app for it.
  // compact: a glass squircle with the name under it, for a row of many; else a card with both inside.
  component AppTile(sec, ref, i, list, compact) {
    let a = find(allApps, x => x.key == ref || startsWith(x.key, "a:" + ref + "/") || lower(x.name) == lower(ref))
    let id = sec + ":" + i
    let isEditing = editing == sec
    Column {
      padding: compact ? [0, 2] : [10, 14]
      radius: 16
      background: compact ? c_clear : (isEditing ? c_glass_edit : c_glass)
      border: compact ? 0 : 1
      borderColor: isEditing ? c_rim_edit : c_rim
      align: center
      justify: center
      gap: 6
      scale: pressed == id ? 0.92 : 1
      animate scale: spring(0.55, 600)
      opacity: a == null ? 0.45 : 1
      onPress: pressed = id
      onRelease: pressed = ""
      onTap: {
        haptic("light")
        if isEditing {
          pickSec = sec
          pickIdx = i
          query = ""
        } else if a != null {
          open(a.key)
        }
      }
      onLongPress: {
        haptic("medium")
        editing = isEditing ? "" : sec
      }
      Box {
        size: compact ? 50 : 28
        radius: 16
        background: compact ? (isEditing ? c_glass_edit : c_glass) : c_clear
        border: compact ? 1 : 0
        borderColor: isEditing ? c_rim_edit : c_rim
        align: center
        if a != null && a.hasIcon {
          Image { src: a.mask; size: 26; tint: c_text_pri; label: a.label }
        } else {
          Text { text: a != null ? a.initials : "?"; fontSize: 14; bold: true; color: c_text_pri; align: center }
        }
        if isEditing {
          // Remove badge, at the icon's corner.
          Box {
            size: 20
            radius: 10
            offset: compact ? [20, -20] : [16, -14]
            background: c_pill_on
            align: center
            onTap: {
              haptic("light")
              tiles = set(tiles, sec, remove(list, i))
            }
            Text { text: "×"; fontSize: 13; bold: true; color: "#000000"; align: center }
          }
        }
      }
      Text {
        text: a != null ? a.name : "not installed"
        fontSize: compact ? 10 : 11
        bold: true
        align: center
        maxLines: 1
        color: c_text_pri
      }
    }
  }

  // A card of app tiles that you can change: long-press a tile or tap "edit", then tap a tile to swap its app,
  // its × to remove it, or + to add one.
  component AppSection(sec, title, defaults, cols, compact = false) {
    let list = get(tiles, sec, defaults)
    let isEditing = editing == sec
    let shown = isEditing ? list : filter(list, r => find(allApps, x => x.key == r || startsWith(x.key, "a:" + r + "/") || lower(x.name) == lower(r)) != null)
    Column {
      fill: width
      background: c_card
      frost: c_frost
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text { text: title; style: label; fontSize: 11; color: c_text_sec; weight: 1 }
        Row {
          padding: [10, 5]
          radius: 10
          background: isEditing ? c_pill_on : c_glass
          border: isEditing ? 0 : 1
          borderColor: c_rim
          onTap: {
            haptic("light")
            editing = isEditing ? "" : sec
          }
          Text { text: isEditing ? "DONE" : "EDIT"; style: label; fontSize: 10; bold: true; color: isEditing ? "#000000" : c_text_sec }
        }
      }

      Grid {
        columns: cols
        gap: 8
        fill: width
        for r, i in shown {
          AppTile { sec: sec; ref: r; i: isEditing ? i : indexOf(list, r); list: list; compact: compact }
        }
        if isEditing {
          // Add a tile.
          Column {
            padding: compact ? [0, 2] : [10, 14]
            radius: 16
            border: compact ? 0 : 1
            borderColor: c_rim_edit
            align: center
            justify: center
            gap: 6
            onTap: {
              haptic("light")
              pickSec = sec
              pickIdx = -1
              query = ""
            }
            Box { size: compact ? 50 : 28; radius: 16; border: compact ? 1 : 0; borderColor: c_rim_edit; align: center; Text { text: "+"; fontSize: 22; color: c_text_pri; align: center } }
            Text { text: "add"; fontSize: 11; bold: true; align: center; color: c_text_sec }
          }
        }
      }

      if isEditing {
        Row {
          fill: width
          justify: spaceBetween
          align: center
          Text { text: "tap tile to change • × to remove"; fontSize: 10; color: c_text_sec }
          Row {
            gap: 8
            align: center
            Text {
              text: "Backup"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("light")
                copy(toJson(tiles))
                notify("My Launcher", "Tiles backup copied to clipboard")
              }
            }
            Text {
              text: "Import"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("light")
                importSec = true
                importText = ""
              }
            }
            Text {
              text: "Reset"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("medium")
                tiles = remove(tiles, sec)
              }
            }
            Text {
              text: "Reset All"
              style: label
              fontSize: 10
              color: c_text_sec
              onTap: {
                haptic("strong")
                tiles = {}
              }
            }
          }
        }
      }

      // The app picker, over everything, for this section.
      Popup {
        visible: pickSec == sec
        onDismiss: {
          pickSec = ""
          query = ""
        }
        width: screenWidth - 48
        padding: 12
        background: "#161618"
        radius: 20
        border: 1
        borderColor: c_rim
        Column {
          fill: width
          gap: 8
          Row {
            fill: width
            align: center
            padding: [10, 8]
            radius: 12
            background: c_pill_off
            Input {
              weight: 1
              placeholder: "Search apps"
              underline: false
              color: c_text_pri
              fontSize: 14
              onChange: query = value
            }
          }
          Column {
            fill: width
            height: 340
            scroll: true
            gap: 2
            for a in picks {
              Row {
                fill: width
                align: center
                gap: 12
                padding: [8, 10]
                radius: 12
                onTap: {
                  haptic("light")
                  let next = pickIdx < 0 ? list + [a.key] : set(list, pickIdx, a.key)
                  tiles = set(tiles, sec, next)
                  pickSec = ""
                  query = ""
                }
                Box {
                  size: 28
                  align: center
                  if a.hasIcon {
                    Image { src: a.mask; size: 24; tint: c_text_pri; label: a.label }
                  } else {
                    Text { text: a.initials; fontSize: 12; bold: true; color: c_text_pri }
                  }
                }
                Text { text: a.name; fontSize: 14; color: c_text_pri; weight: 1; maxLines: 1 }
              }
            }
          }
        }
      }

      // The import backup popup, over everything.
      Popup {
        visible: importSec
        onDismiss: {
          importSec = false
          importText = ""
        }
        width: screenWidth - 48
        padding: 16
        background: "#161618"
        radius: 20
        border: 1
        borderColor: c_rim
        Column {
          fill: width
          gap: 12
          Row {
            fill: width
            justify: spaceBetween
            align: center
            Text { text: "RESTORE TILES BACKUP"; style: label; fontSize: 11; color: c_text_sec }
            Text {
              text: "✕"
              fontSize: 14
              color: c_text_sec
              onTap: {
                importSec = false
                importText = ""
              }
            }
          }
          Text {
            text: "Paste your exported tiles JSON configuration below:"
            fontSize: 12
            color: c_text_sec
          }
          Row {
            fill: width
            align: center
            padding: [10, 8]
            radius: 12
            background: c_pill_off
            border: 1
            borderColor: c_border
            Input {
              weight: 1
              placeholder: "Paste JSON here..."
              underline: false
              color: c_text_pri
              fontSize: 13
              onChange: importText = value
              onSubmit: {
                haptic("medium")
                let p = parseJson(value)
                if p != null {
                  tiles = p
                  importSec = false
                  importText = ""
                  notify("My Launcher", "Tiles configuration restored")
                }
              }
            }
          }
          Row {
            fill: width
            justify: end
            gap: 8
            Box {
              padding: [8, 14]
              radius: 10
              background: c_pill_off
              onTap: {
                importSec = false
                importText = ""
              }
              Text { text: "Cancel"; fontSize: 12; color: c_text_sec }
            }
            Box {
              padding: [8, 14]
              radius: 10
              background: c_pill_on
              onTap: {
                haptic("medium")
                let p = parseJson(importText)
                if p != null {
                  tiles = p
                  importSec = false
                  importText = ""
                  notify("My Launcher", "Tiles configuration restored")
                }
              }
              Text { text: "Apply"; fontSize: 12; bold: true; color: "#000000" }
            }
          }
        }
      }
    }
  }

  background: c_bg
  padding: [16, 20, 16, 20]

  Column {
    gap: 14
    fill: width
    scroll: true

    // Top Header: Navigation & Status
    Row {
      fill: width
      align: center
      Text {
        text: "MEDIA & SOUND HUB"
        style: label
        fontSize: 12
        bold: true
        color: c_text_sec
        weight: 1
      }
      Row {
        gap: 6
        align: center

        // All Apps Drawer Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("drawer")
          }
          Text {
            text: "APPS"
            fontSize: 10
            bold: true
            color: c_text_sec
          }
        }

        // Home Navigation Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:-1")
          }
          Text {
            text: "HOME ›"
            fontSize: 10
            bold: true
            color: c_text_pri
          }
        }

        // Work Navigation Trigger
        Row {
          padding: [8, 5]
          radius: 12
          background: c_card
          border: 1
          borderColor: c_border
          align: center
          onTap: {
            haptic("light")
            launcher("page:0")
          }
          Text {
            text: "WORK ›"
            fontSize: 10
            bold: true
            color: c_text_sec
          }
        }
      }
    }

    // ==========================================
    // 1. HERO NOW-PLAYING CARD (Top of screen)
    // ==========================================
    Column {
      fill: width
      background: c_card
      frost: c_frost
      border: 1
      borderColor: c_border
      radius: 24
      padding: 18
      gap: 16

      // Album Artwork / Audio Visualizer Frame
      Box {
        fill: width
        height: 240
        radius: 20
        background: "#08080A"
        border: 1
        borderColor: c_border
        align: center
        clip: true
        onTap: media("open")

        if m != null && m.art != null {
          Image {
            src: m.art
            fill: true
            fit: cover
            radius: 20
          }
        } else {
          // Monochrome Stylized Audio Canvas Frame
          Column {
            align: center
            justify: center
            gap: 10
            Text {
              text: isPlaying ? "♫" : "♪"
              fontSize: 48
              align: center
              color: c_text_pri
            }
            Text {
              text: isPlaying ? "PLAYING AUDIO" : "AUDIO READY"
              style: label
              fontSize: 11
              bold: true
              letterSpacing: 2
              align: center
              color: c_text_sec
            }
          }
        }
      }

      // Track Metadata & Source App Badge
      Column {
        fill: width
        gap: 4
        Row {
          fill: width
          align: center
          Text {
            text: trackTitle
            fontSize: 20
            bold: true
            color: c_text_pri
            weight: 1
            maxLines: 1
          }
          Row {
            padding: [8, 4]
            radius: 8
            background: c_pill_off
            border: 1
            borderColor: c_border
            align: center
            Text {
              text: sourceApp
              fontSize: 10
              bold: true
              color: c_text_sec
            }
          }
        }
        Text {
          text: trackArtist
          fontSize: 14
          color: c_text_sec
          maxLines: 1
        }
      }

      // Interactive Scrubber & Timestamps
      Column {
        fill: width
        gap: 2
        if canSeek {
          Slider {
            value: pos
            min: 0
            max: safeDur
            live: true
            fill: width
            color: c_text_pri
            track: "#2C2C2E"
            onChange: media("seek", value)
          }
        } else {
          // Progress only, for a player that can't seek: a slider here would snap back when dragged.
          Row {
            fill: width
            height: 28
            align: center
            Box { weight: played; height: 4; background: hasDur ? c_text_pri : "#2C2C2E" }
            Box { weight: 1 - played; height: 4; background: "#2C2C2E" }
          }
        }
        Row {
          fill: width
          Text {
            text: fmtTime(pos, "m:ss", "UTC")
            fontSize: 11
            color: c_text_sec
            weight: 1
          }
          Text {
            text: hasDur ? "-${fmtTime(remaining, 'm:ss', 'UTC')}" : "—"
            fontSize: 11
            color: c_text_sec
          }
        }
      }

      // Oversized Tactile Transport Controls
      Row {
        fill: width
        align: center
        justify: spaceEvenly

        // Shuffle Toggle
        Box {
          size: 46
          radius: 23
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("action", "shuffle")
          Text {
            text: "⇄"
            fontSize: 20
            bold: true
            align: center
            color: c_text_sec
          }
        }

        // Previous Track
        Box {
          size: 54
          radius: 27
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("previous")
          Text {
            text: "⏮"
            fontSize: 22
            align: center
            color: c_text_pri
          }
        }

        // Prominent Inverted White Play/Pause Button
        Box {
          size: 72
          radius: 36
          background: c_pill_on
          align: center
          onTap: media("toggle")
          Text {
            text: isPlaying ? "⏸" : "▶"
            fontSize: 28
            align: center
            color: "#000000"
          }
        }

        // Next Track
        Box {
          size: 54
          radius: 27
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("next")
          Text {
            text: "⏭"
            fontSize: 22
            align: center
            color: c_text_pri
          }
        }

        // Repeat Toggle
        Box {
          size: 46
          radius: 23
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          onTap: media("action", "repeat")
          Text {
            text: "↻"
            fontSize: 20
            bold: true
            align: center
            color: c_text_sec
          }
        }
      }

      // Output Device Switcher Pill
      Row {
        fill: width
        padding: [12, 10]
        radius: 14
        background: c_pill_off
        border: 1
        borderColor: c_border
        align: center
        gap: 8
        onTap: settings("output")
        Text { text: "◖◗"; fontSize: 12; color: c_text_pri; align: center }
        Text {
          text: "Audio Output:"
          fontSize: 12
          color: c_text_sec
        }
        Text {
          text: outName
          fontSize: 12
          bold: true
          color: c_text_pri
          weight: 1
        }
        Text {
          text: "SWITCH ›"
          fontSize: 10
          bold: true
          color: c_text_sec
        }
      }
    }

    // ==========================================
    // 2. MEDIA APPS: editable (long-press a tile or tap EDIT)
    // ==========================================
    AppSection {
      sec: "media"
      title: "STREAMING & MEDIA APPS"
      defaults: ["yt-mini", "CineStream", "AniStream", "com.netflix.mediaclient", "Gallery", "Photos"]
      cols: 3
    }

    // ==========================================
    // 3. AUDIO & PLAYBACK QUICK CONTROLS (Bottom)
    // ==========================================
    Column {
      fill: width
      background: c_card
      frost: c_frost
      border: 1
      borderColor: c_border
      radius: 20
      padding: 16
      gap: 12

      Row {
        fill: width
        align: center
        Text {
          text: "MASTER AUDIO VOLUME"
          style: label
          fontSize: 11
          color: c_text_sec
          weight: 1
        }
        Text {
          text: volText
          fontSize: 12
          bold: true
          color: c_text_pri
        }
        Row {
          gap: 6
          align: center
          for level in [0, 50, 100] {
            let lvlStr = level == 0 ? "MUTE" : "${level}%"
            Row {
              padding: [6, 3]
              radius: 6
              background: c_pill_off
              border: 1
              borderColor: c_border
              onTap: {
                haptic("light")
                volume(level)
              }
              Text { text: lvlStr; fontSize: 9; bold: true; color: c_text_sec }
            }
          }
        }
      }

      Slider {
        value: volPct
        min: 0
        max: 100
        live: true
        fill: width
        color: c_text_pri
        track: "#2C2C2E"
        onChange: volume(value)
      }

      Row {
        fill: width
        gap: 8

        // Quick Equalizer / Dolby Atmos Settings Pill
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: settings("sound")
          Text { text: "≑"; fontSize: 13; bold: true; color: c_text_pri; align: center }
          Text {
            text: "Equalizer & Dolby"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }

        // Quick Volume Settings Sheet
        Row {
          weight: 1
          padding: [10, 8]
          radius: 12
          background: c_pill_off
          border: 1
          borderColor: c_border
          align: center
          justify: center
          gap: 6
          onTap: settings("volume")
          Text { text: "♪"; fontSize: 12; bold: true; color: c_text_pri; align: center }
          Text {
            text: "Sound Settings"
            fontSize: 11
            bold: true
            color: c_text_pri
          }
        }
      }
    }

    // Bottom Navigation Bar Spacing
    Spacer { height: screenInset + 12 }
  }
}
